# ls
alias ls="ls --color --time-style=long-iso"
alias la="ls -a --color --time-style=long-iso"
alias lf="ls -F --color --time-style=long-iso"
alias ll="ls -alG --color --time-style=long-iso"
alias cless="less -R"

# du/df
alias du="du -h"
alias df="df -h"
alias duh="du -h ./ --max-depth=1"

# su
alias su="su -l"

# vim
alias -g V="| nvim -"
alias vi=nvim
alias vim=nvim

# grep
alias 'gr'='grep --color=auto -RUIn'
alias 'grep'='grep -s'

# etc
alias weather='clear; curl ja.wttr.in/Uruma'
alias li='eza -a -l --icons --git -h -g'
alias lt='eza -a -l --icons --tree --git -h -g'
alias cdiff='colordiff -u'
alias star='eval "$(starship init zsh)"'
alias gitchg='for dir in */; do ([ -d "$dir" ] && cd "$dir" && [ -d .git ] && git status --short | grep -q . && echo "$dir has changes"); done'

alias ...="../../"
alias ....="../../../"
alias .....="../../../../"
